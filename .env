# =============================================
# Looply - 환경변수 설정
# =============================================

# ── PostgreSQL ────────────────────────────────
POSTGRES_DB=sns_db
POSTGRES_USER=sns_user
POSTGRES_PASSWORD=changeme_db_password

# ── Redis ─────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password

# ── JWT ───────────────────────────────────────
JWT_SECRET=changeme_jwt_secret_must_be_at_least_256bits_long_string_here
JWT_ACCESS_EXPIRY=3600000
JWT_REFRESH_EXPIRY=604800000

# ── Spring Boot ───────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── MinIO ─────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PUBLIC_URL=http://localhost:9100

# ── SonarQube ─────────────────────────────────
SONAR_JDBC_PASSWORD=changeme_sonar_password

# ── Jenkins ───────────────────────────────────
# 관리자 계정 비밀번호 (ID: admin)
JENKINS_ADMIN_PASSWORD=admin
# Gitea 액세스 토큰: Gitea → Settings → Applications → Generate Token (repository: Read)
GITEA_ACCESS_TOKEN=a4364341000e8b1a3cfc32eba9838e9ec36408cb
