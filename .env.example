# =============================================
# Looply - 환경변수 예시
# 이 파일을 .env로 복사 후 값을 변경하세요
# cp .env.example .env
# =============================================

# ── PostgreSQL ────────────────────────────────
POSTGRES_DB=sns_db
POSTGRES_USER=sns_user
POSTGRES_PASSWORD=changeme_db_password

# ── Redis ─────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password

# ── JWT ───────────────────────────────────────
# 256bit 이상 랜덤 문자열 필수 (openssl rand -hex 32)
JWT_SECRET=changeme_jwt_secret_must_be_at_least_256bits_long_string_here
JWT_ACCESS_EXPIRY=3600000      # 1시간 (ms)
JWT_REFRESH_EXPIRY=604800000   # 7일 (ms)

# ── Spring Boot ───────────────────────────────
# dev | prod
SPRING_PROFILES_ACTIVE=dev

# ── MinIO ─────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_PUBLIC_URL=http://localhost:9100

# ── SonarQube (인프라 compose 사용 시) ──────────
SONAR_JDBC_PASSWORD=changeme_sonar_password

# ── Jenkins (인프라 compose 사용 시) ────────────
# 관리자 계정 비밀번호 (ID: admin)
JENKINS_ADMIN_PASSWORD=changeme_jenkins_password
# Gitea 액세스 토큰
# 발급: Gitea 로그인 → Settings → Applications → Generate New Token
# 권한: repository - Read 만 선택
GITEA_ACCESS_TOKEN=changeme_gitea_access_token

# ── Docker 내부 네트워크 호스트 ────────────────
# application.yml에서 직접 참조하는 Docker 서비스 이름
# 로컬 직접 실행 시 설정 불필요 (기본값: localhost 사용)
DB_HOST=db
REDIS_HOST=redis
REDIS_PORT=6379
MINIO_ENDPOINT=http://minio:9000
